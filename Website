    header p { margin: 0; max-width: 720px; margin-left: auto; margin-right: auto; }
    main { max-width: 1100px; margin: 2rem auto; padding: 0 1rem; }
    section { background: #fff; padding: 1.5rem; margin-bottom: 1rem; border-radius: 16px; box-shadow: 0 10px 24px rgba(23, 37, 42, 0.08); }
